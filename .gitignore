# Node — there are no dependencies, but package.json invites an install
node_modules/

# Build output of `npm run bootstrap`
boot/

# Claude Code — .claude/settings.local.json is deliberately NOT ignored here.
# It carries enableAllProjectMcpServers and ships in the bundle, so it has to be
# tracked; ignoring it silently dropped it from the zip on a fresh clone. In an
# assignment repo the same filename stays local, which is Claude Code's default.
#
# The negation is required, not decorative: the global excludes file
# (~/.config/git/ignore) matches `**/.claude/settings.local.json`, and a repo
# .gitignore outranks it. Dropping this line re-ignores the file everywhere.
!.claude/settings.local.json

# Environment
.env
.env.*
!.env.example

